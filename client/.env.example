# Copy to .env.local to run the client against a local server
REACT_APP_API_URL=http://localhost:5000/api

# Which site this build is:  all (default) | customer | worker
# Deploy the same code as two Vercel projects (one with customer, one with worker) for separate sites.
REACT_APP_PORTAL=all

# Minutes of inactivity before the AI chat resets
# REACT_APP_CHAT_EXPIRY_MINUTES=30
