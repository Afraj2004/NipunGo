# Copy to .env (never commit the real one)

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nipungo?retryWrites=true&w=majority
JWT_SECRET=<long random string>

# Where the website lives (extra allowed CORS origins, links in emails)
CLIENT_URL=https://nipungo.vercel.app

# ── Email (OTP, booking emails) ───────────────────────────
# Production: Brevo API. Works on Render's free tier (HTTPS, no SMTP ports needed).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=            # must be a sender verified in your Brevo account
BREVO_SENDER_NAME=NipunGo
# Local development only: Gmail app-password SMTP (blocked on many hosts)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=NipunGo <you@gmail.com>
# MAIL_DRY_RUN=true            # print emails to the console instead of sending

# AI chat
GEMINI_API_KEY=
# GEMINI_MODEL=                # optional: first model to try

# Payments / uploads
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
